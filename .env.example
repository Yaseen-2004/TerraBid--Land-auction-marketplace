# ----------------------------------------------------------------------------
# TerraBid Land Auction Platform — copy to .env and adjust.
# ----------------------------------------------------------------------------

# PostgreSQL + PostGIS (asyncpg driver). Docker Compose overrides the host to "db".
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/landauction
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=landauction

# Redis. Docker Compose overrides the host to "redis".
REDIS_URL=redis://localhost:6379/0

# JWT — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Optional ArcGIS location-platform key. Without it the public Esri tile services are used.
ESRI_API_KEY=

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Optional tuning
ENVIRONMENT=development
LOG_LEVEL=INFO
WEB_CONCURRENCY=2
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_BIDS_PER_10S=20
WS_ALLOW_ANONYMOUS=true
