# Only needed when the frontend and backend are hosted on different origins
# (e.g. frontend on Vercel, backend on Railway/Render). Leave unset for the
# Docker Compose / local dev setup, where the backend is same-origin (proxied).
#
# Must be the backend's full origin, no trailing slash, no /api suffix:
VITE_API_BASE=https://terrabid-api.up.railway.app
