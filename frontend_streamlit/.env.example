# Backend origin. The Streamlit server calls the FastAPI backend directly
# (server-to-server), so there's no browser CORS to configure here at all —
# unlike a JS SPA, nothing in the viewer's browser ever talks to the backend.
API_BASE_URL=http://localhost:8000

# Optional: ArcGIS key for higher-rate-limit satellite tiles. Public Esri
# tiles are used when unset (same default as the backend's ESRI_API_KEY).
ESRI_API_KEY=
